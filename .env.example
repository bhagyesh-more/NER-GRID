# ==============================================================================
# NER-GRID: Environment Configuration Template
# Problem Statement: SIH26002 (SIH 2026)
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# NEVER commit .env to source control.
# ==============================================================================

# --- Application Settings ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Strict Data Integrity & Provenance ---
# Set to 'false' in production/audit modes. When 'true', any simulated data
# used as fallback MUST be explicitly tagged with DataOrigin.SIMULATED.
ALLOW_SIMULATED_DATA=true
ENFORCE_DATA_PROVENANCE=true

# --- Open Government Data (OGD) / data.gov.in ---
# Register at https://data.gov.in to obtain an API key for Indian government datasets
DATA_GOV_IN_API_KEY=your_ogd_api_key_here
DATA_GOV_IN_BASE_URL=https://api.data.gov.in

# --- India Meteorological Department (IMD) / Weather Ingestion ---
# Primary IMD endpoints or proxy configurations
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=optional_imd_key_if_subscribed
# High-resolution calibrated fallback (Open-Meteo provides ECMWF/GFS calibrated feeds)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Bhuvan / NRSC / ISRO Geospatial Services ---
BHUVAN_TOKEN=optional_bhuvan_portal_token
BHUVAN_WMS_BASE_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
BHUVAN_DISASTER_WMS_URL=https://bhuvan-app1.nrsc.gov.in/bhuvan2d/bhuvan/wms

# --- North Eastern Space Applications Centre (NESAC / NeSDR) ---
NESAC_BASE_URL=https://nesdr.gov.in
NESAC_API_KEY=optional_nesac_token_here

# --- OpenStreetMap & Road Network ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BACKEND_URL=http://localhost:5000
VALHALLA_BACKEND_URL=http://localhost:8002

# --- Digital Elevation Models (DEM) & Local GeoTIFF Stores ---
# Path to local GeoTIFF tiles (Copernicus DEM 30m / SRTM 30m)
DEM_DATA_DIR=./data/raw/elevation
PROCESSED_GEO_DIR=./data/processed

# --- Map Tile Providers (Frontend) ---
# MapTiler or Mapbox API key for satellite/terrain basemaps in MapLibre GL
MAPTILER_API_KEY=your_maptiler_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# --- Storage & Caching ---
DATABASE_URL=sqlite:///./data/ner_grid.db
# For production/staging with PostGIS:
# DATABASE_URL=postgresql://user:password@localhost:5432/ner_grid_gis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
